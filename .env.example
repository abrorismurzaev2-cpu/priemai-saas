# ===========================================
# ПриёмAI — Environment Variables
# Скопируйте в .env.local и заполните значения
# ===========================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ПриёмAI

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Vapi.ai ---
VAPI_API_KEY=your_vapi_private_key
VAPI_PUBLIC_KEY=your_vapi_public_key
VAPI_WEBHOOK_SECRET=your_webhook_secret
VAPI_DEFAULT_ASSISTANT_ID=

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Zadarma ---
ZADARMA_USER_KEY=
ZADARMA_SECRET_KEY=
ZADARMA_SIP_NUMBER=

# --- Google Calendar ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# --- amoCRM ---
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=http://localhost:3000/api/crm/amocrm/callback
AMOCRM_BASE_DOMAIN=

# --- Bitrix24 ---
BITRIX24_WEBHOOK_URL=

# --- ЮKassa ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:3000/dashboard/billing?success=1

# --- SMS / Telegram ---
SMS_PROVIDER=twilio
SMSRU_API_ID=
TELEGRAM_BOT_TOKEN=

# --- Безопасность ---
NEXTAUTH_SECRET=
CRON_SECRET=
